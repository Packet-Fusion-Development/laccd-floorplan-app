{
  "name": "pf-site-survey",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Packet Fusion Site Survey — multi-project field survey platform on Cloudflare Workers",
  "scripts": {
    "build": "node scripts/laccd/build-catalog.mjs",
    "dev": "npm run build && wrangler dev",
    "dev:remote": "npm run build && wrangler dev --remote",
    "deploy": "npm run build && wrangler deploy",
    "deploy:test": "npm run build && wrangler deploy --env test",
    "test": "node scripts/test-access.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "demo:build": "node scripts/build-demo.mjs",
    "laccd:seed:build": "node scripts/laccd/build-seed.mjs",
    "laccd:seed:local": "npm run laccd:seed:build && wrangler d1 execute DB --local --file data/laccd/seed/laccd.sql",
    "laccd:seed:remote": "npm run laccd:seed:build && wrangler d1 execute DB --remote --file data/laccd/seed/laccd.sql",
    "laccd:upload-pdfs": "node --env-file-if-exists=.env scripts/laccd/upload-pdfs.mjs",
    "laccd:verify-r2": "node --env-file-if-exists=.env scripts/laccd/verify-r2.mjs",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=22"
  }
}
