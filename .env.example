# Credentials for the LACCD project's drawing scripts
# (npm run laccd:upload-pdfs / laccd:verify-r2). Copy to .env and fill in.
# Not needed for `npm run dev`, any deploy, or other projects.
#
# Create the token at:
#   Cloudflare dashboard → R2 → API → Manage API tokens → Create API token
#   Permission: "Object Read & Write", scoped to the laccd-floorplans bucket.

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=laccd-floorplans
