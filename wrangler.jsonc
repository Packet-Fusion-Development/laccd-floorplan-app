{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laccd-floorplan-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // itcontact@packetfusion.com's account. Pinned explicitly because the OAuth
  // tokens in use can see several accounts, and wrangler refuses to guess.
  "account_id": "521c322a89a17bb69f91f1e65177606e",

  "observability": {
    "enabled": true
  },

  // Cloudflare Access can only protect a hostname on a zone in this account —
  // it cannot protect *.workers.dev. So the app moves to a custom domain and
  // workers.dev is switched off, rather than left open beside the gated door.
  //
  // Deploying this creates the DNS record. Create the Access application
  // FIRST (see README) so the hostname is never briefly public.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "laccd-floorplan-app.packetfusion.com",
      "custom_domain": true
    }
  ],

  "vars": {
    // Both must be set for the Worker to enforce Access. Empty = open.
    // ACCESS_AUD is the application's AUD tag, not a secret.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only PDF requests need the Worker. The shell, catalog.json, and all 719
    // thumbnails are served straight from the edge with no Worker invocation.
    "run_worker_first": ["/pdfs/*"]
  },

  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "laccd-floorplans",
      // `wrangler dev` reads from the real bucket instead of a local stub, so
      // local testing exercises the same objects production serves.
      "preview_bucket_name": "laccd-floorplans"
    }
  ]
}
