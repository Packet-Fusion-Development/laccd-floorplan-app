# Normalise to LF in the repo so Windows and macOS checkouts don't churn diffs.
* text=auto eol=lf

# Binary — never touch line endings.
*.pdf   binary
*.jpg   binary
*.png   binary
*.xlsx  binary

# Generated / bulk files: keep them out of diffs and language stats.
package-lock.json   linguist-generated=true -diff
data/catalog.json   linguist-generated=true
public/thumbs/**    linguist-vendored=true
